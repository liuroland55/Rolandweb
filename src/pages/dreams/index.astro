---
// 演示用：新增虚构栏目「梦记」，验证「加一个栏目」的改动量足够小（见 README §3）。
// 这个文件在演示完之后会被回滚，不会留在正式历史里。
import { getCollection } from 'astro:content';
import SectionLayout from '../../layouts/SectionLayout.astro';
import EntryListRow from '../../components/content/EntryListRow.astro';

const entries = (await getCollection('dreams', (e) => e.data.draft !== true)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---
<SectionLayout section="all" mastheadTitle="梦" mastheadMeta={`${entries.length} 条`} title="梦">
  <div class="entry-list">
    {entries.map((entry) => (
      <EntryListRow href={`/dreams/${entry.id}`} date={entry.data.date} genre="梦记" title={entry.data.title} />
    ))}
  </div>
</SectionLayout>
