---
// 相册列表。private 卷完全不出现在这里（不进列表、不进 sitemap、不进 RSS，见 CLAUDE.md 硬约束 5）。
// group 卷默认按"未开放"渲染——是否解锁要等 Phase 7 的会话脚本在浏览器里问过 Worker 才知道，
// 这里给的是安全的服务端默认值，不是最终状态。
import { getCollection } from 'astro:content';
import SectionLayout from '../../layouts/SectionLayout.astro';
import { formatDate, toISODate } from '../../lib/format';
import { withBase } from '../../lib/site';

const rolls = (await getCollection('photos', (e) => e.data.draft !== true && e.data.visibility !== 'private')).sort(
  (a, b) => b.data.shot_at.getTime() - a.data.shot_at.getTime(),
);
---
<SectionLayout
  section="photos"
  mastheadTitle="照片"
  mastheadMeta={`${rolls.length} 卷`}
  title="照片"
  description="按卷发布的照片：公开的卷任何人都能看，友邻卷需要登录才能解锁。"
>
  <div class="roll-grid">
    {rolls.map((roll) => {
      const isPublic = roll.data.visibility === 'public';
      return (
        <article class="roll-card" data-roll={roll.data.roll} data-roll-visibility={roll.data.visibility}>
          <div class:list={['roll-card__cover', 'placeholder', !isPublic && 'roll-card__cover--locked']}>
            <span class="placeholder__caption">{roll.data.count} 张{roll.data.film_stock ? ` · ${roll.data.film_stock}` : ''}</span>
          </div>
          <div class="roll-card__body">
            <div class="roll-card__title-row">
              <a class="roll-card__title" href={withBase(`/photos/${roll.data.roll}`)}>{roll.data.title}</a>
              <span
                class:list={['roll-card__badge', isPublic ? 'roll-card__badge--public' : 'roll-card__badge--locked']}
                data-roll-badge
              >
                {isPublic ? '公开' : '未开放'}
              </span>
            </div>
            <div class="roll-card__meta">
              <time datetime={toISODate(roll.data.shot_at)}>{formatDate(roll.data.shot_at, { withYear: false })}</time> ·{' '}
              {isPublic ? `${roll.data.count} 张 · 打包下载 ${roll.data.download?.size ?? ''}` : `${roll.data.count} 张 · 仅好友可见`}
            </div>
            {!isPublic && (
              <a class="roll-card__request" href={withBase(`/photos/${roll.data.roll}#request-access`)} data-roll-request>申请查看 →</a>
            )}
          </div>
        </article>
      );
    })}
  </div>
</SectionLayout>

<script>
  // 相册权限 island（登录 island 的延伸，见 CLAUDE.md 硬约束 7）：
  // 问一次 /api/me，把已解锁的 group 卷从"未开放"换成"已解锁"外观。
  // 没问到、或者不在可见列表里，就保持服务端渲染的安全默认值不动。
  import { fetchSession, canSeeRoll } from '../../lib/auth';

  fetchSession().then((result) => {
    if (result.status !== 'ok') return;
    document.querySelectorAll<HTMLElement>('[data-roll][data-roll-visibility="group"]').forEach((card) => {
      const roll = card.dataset.roll;
      if (!roll || !canSeeRoll(result.session, roll)) return;

      const badge = card.querySelector<HTMLElement>('[data-roll-badge]');
      if (badge) {
        badge.textContent = '已解锁';
        badge.classList.remove('roll-card__badge--locked');
        badge.classList.add('roll-card__badge--public');
      }
      card.querySelector('.roll-card__cover--locked')?.classList.remove('roll-card__cover--locked');
      card.querySelector('[data-roll-request]')?.remove();
      card.classList.add('roll-card--unlocked');
    });
  });
</script>
