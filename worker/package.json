{
  "name": "shiyu-worker",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute shiyu-db --local --file=./src/db/schema.sql",
    "db:migrate:remote": "wrangler d1 execute shiyu-db --remote --file=./src/db/schema.sql",
    "typecheck": "tsc --noEmit",
    "release": "node scripts/deploy.mjs",
    "release:local": "node scripts/deploy.mjs --local"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "typescript": "^5.7.0",
    "wrangler": "^4.130.0"
  }
}
